GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=

# Same public OAuth Web client ID as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in Expo.
GOOGLE_WEB_CLIENT_ID=
# Exact browser origins permitted to submit authenticated requests (comma-separated).
AUTH_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8000,http://localhost:8080
# Local HTTP only: set false. Production HTTPS: leave true.
AUTH_COOKIE_SECURE=true
# Persist this file on a volume when running Docker.
AUTH_SESSION_DB=.adk/auth.sqlite3
