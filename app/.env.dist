GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=

# Same public OAuth Web client ID as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in Expo.
GOOGLE_WEB_CLIENT_ID=
# Optional CORS origins (comma-separated). Authentication always requires a bearer token.
AUTH_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8000,http://localhost:8080

# Example: alice@example.com,bob@example.com.
AUTH_ALLOWED_EMAILS=guillaume.bailleul@gmail.com
